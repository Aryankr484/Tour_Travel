<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css"
    rel="stylesheet"/>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white text-white p-10">
        <div class="w-full flex justify-end">
            <a class="bg-red-500 rounded-md px-3 py-1 mb-5 inline-block" href="/logout">Logout</a>
        </div>
        <div class="flex gap-4 mb-3 items-center">
            <div class="h-10 w-10 rounded-md overflow-hidden">
                <a href="profile/upload"><img class="w-full h-full object-cover" src="/images/uploads/<%= user.PROFILEPIC %>" alt=""></a>
            </div>
            <h3 class="text-3xl"><span class="font-light">Hello</span>, <%= user.NAME %>👋</h3>
        </div>
    <h1 class="text-xl mb-5 mt-10">Enter the Boarding and Destination</h1>
    <form class="flex items-center" action="/submit" method="post">
        <input placeholder="From" type="text" class="bg-transparent w-40 px-2 mb-2 mr-10 py-2 border-2 rounded-lg border-zinc-700 outline-none" name="fr_" id="From">
        <i class="text-xl ri-arrow-left-right-fill"></i>
        <input placeholder="To" type="text" class="bg-transparent w-40 px-2 mb-2 ml-10 py-2 border-2 rounded-lg border-zinc-700 outline-none" name="to_" id="To">
        <input class='px-3 w-40 text-sm py-2 bg-blue-500 block rounded-md mb-2 ml-10' type="submit" value="Book">
    </form>
</body>
</html>