<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Destination</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css"
    rel="stylesheet"/>
</head>
<body class="bg-zinc-900 text-white min-h-screen">
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <!-- Logout Button -->
        <div class="w-full flex justify-end">
            <a class="bg-red-500 hover:bg-red-600 transition px-4 py-2 rounded-md text-white font-semibold" href="/logout">Logout</a>
        </div>

        <!-- User Greeting -->
        <div class="flex gap-4 mb-6 items-center">
            <div class="h-12 w-12 rounded-full overflow-hidden">
                <a href="profile/upload">
                    <img class="w-full h-full object-cover" src="/images/uploads/<%= user.PROFILEPIC %>" alt="Profile Picture">
                </a>
            </div>
            <h3 class="text-3xl font-semibold">Hello, <span class="text-green-400"><%= user.NAME %></span> 👋</h3>
        </div>

        <!-- Boarding and Destination Section -->
        <h1 class="text-2xl font-bold mb-6">Enter the Boarding and Destination</h1>
        <form class="flex flex-col space-y-6" action="/submit" method="post">
            <div class="flex items-center gap-10">
                <!-- From Input -->
                <div class="relative">
                    <input placeholder="From" type="text" class="bg-transparent w-60 px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" name="fr_" id="fromInput" autocomplete="off">
                    <ul id="fromSuggestions" class="absolute bg-white text-black w-60 mt-1 rounded-md shadow-lg hidden"></ul>
                </div>
                <i class="text-2xl ri-arrow-left-right-fill text-green-400"></i>
                <!-- To Input -->
                <div class="relative">
                    <input placeholder="To" type="text" class="bg-transparent w-60 px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" name="to_" id="toInput" autocomplete="off">
                    <ul id="toSuggestions" class="absolute bg-white text-black w-60 mt-1 rounded-md shadow-lg hidden"></ul>
                </div>
            </div>

            <!-- Mode of Transport Section -->
            <h2 class="text-xl font-semibold mt-6 mb-4">Mode of Transport</h2>
            <div class="flex flex-wrap gap-6">
                <label class="flex items-center cursor-pointer">
                    <input type="radio" name="mode_" value="Car" class="mr-2">
                    <span class="text-lg">Car</span>
                </label>
                <label class="flex items-center cursor-pointer">
                    <input type="radio" name="mode_" value="Bus" class="mr-2">
                    <span class="text-lg">Bus</span>
                </label>
                <label class="flex items-center cursor-pointer">
                    <input type="radio" name="mode_" value="Train" class="mr-2">
                    <span class="text-lg">Train</span>
                </label>
                <label class="flex items-center cursor-pointer">
                    <input type="radio" name="mode_" value="Flight" class="mr-2">
                    <span class="text-lg">Flight</span>
                </label>
            </div>

            <!-- Submit Button -->
            <input class="px-4 py-2 bg-blue-500 hover:bg-blue-600 transition text-white font-semibold rounded-md w-40 mt-6" type="submit" value="Book">
        </form>
    </div>

    <script>
        async function fetchSuggestions(inputId, suggestionsId) {
            const input = document.getElementById(inputId);
            const suggestions = document.getElementById(suggestionsId);

            input.addEventListener('input', async () => {
                const query = input.value.trim();
                if (query.length < 2) {
                    suggestions.innerHTML = '';
                    suggestions.classList.add('hidden');
                    return;
                }

                try {
                    const response = await fetch(`/api/city-suggestions?name=${query}`);
                    const data = await response.json();

                    if (data.success) {
                        suggestions.innerHTML = data.cities
                            .map(city => `<li class="px-2 py-1 cursor-pointer hover:bg-gray-200">${city.name}</li>`)
                            .join('');
                        suggestions.classList.remove('hidden');

                        // Add click event to suggestions
                        Array.from(suggestions.children).forEach(item => {
                            item.addEventListener('mousedown', (e) => {
                                e.preventDefault(); // Prevent blur event from clearing the suggestions
                                input.value = item.textContent;
                                suggestions.innerHTML = '';
                                suggestions.classList.add('hidden');
                            });
                        });
                    }
                } catch (err) {
                    console.error('Error fetching suggestions:', err);
                }
            });

            // Hide suggestions when input loses focus
            input.addEventListener('blur', () => {
                setTimeout(() => {
                    suggestions.innerHTML = '';
                    suggestions.classList.add('hidden');
                }, 100);
            });
        }

        // Initialize autocomplete for "From" and "To" inputs
        fetchSuggestions('fromInput', 'fromSuggestions');
        fetchSuggestions('toInput', 'toSuggestions');
    </script>
</body>
</html>