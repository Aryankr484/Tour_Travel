<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Destination</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css"
    rel="stylesheet"/>
</head>
<body style="background-image: url('https://images.unsplash.com/photo-1643236312558-2725e111238b?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');" class="bg-cover bg-center text-gray-800 min-h-screen flex flex-col">

    <!-- Navbar -->
    <header class="bg-white bg-opacity-50 shadow-md">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <a href="/" class="text-2xl font-bold text-blue-500">JourneySphere</a>
            <nav class="space-x-4">
                <a href="/" class="text-gray-600 hover:text-gray-800 transition">Home</a>
                <a href="/logout" class="text-red-500 hover:text-red-600 transition">Logout</a>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow container mx-auto px-4 py-10">
        <!-- User Greeting -->
   
        
        <div class="flex items-center gap-4 mb-8">
            <div class="h-16 w-16 rounded-full overflow-hidden border-2 border-blue-500">
                <a href="profile/upload">
                    <img class="w-full h-full object-cover" src="/images/uploads/<%= user.PROFILEPIC %>" alt="Profile Picture">
                </a>
            </div>
            <h3 class="text-3xl font-semibold">Hello, <span class="text-blue-500"><%= user.NAME %></span></h3>
        </div>

        <!-- Boarding and Destination Section -->
        <div class="bg-white bg-opacity-70 p-6 rounded-lg shadow-lg">
            <h1 class="text-2xl font-bold mb-6 text-gray-700">Enter the Boarding and Destination</h1>
            <form class="space-y-6" action="/submit" method="post">
                <div class="flex items-center gap-10">
                    <!-- From Input -->
                    <div class="relative">
                        <input placeholder="From" type="text" class="bg-gray-50 w-60 px-4 py-2 border-2 rounded-lg border-gray-300 outline-none focus:border-blue-500" name="fr_" id="fromInput" autocomplete="off">
                        <ul id="fromSuggestions" class="absolute bg-white text-gray-800 w-60 mt-1 rounded-md shadow-lg hidden"></ul>
                    </div>
                    <i class="text-2xl ri-arrow-left-right-fill text-blue-500"></i>
                    <!-- To Input -->
                    <div class="relative">
                        <input placeholder="To" type="text" class="bg-gray-50 w-60 px-4 py-2 border-2 rounded-lg border-gray-300 outline-none focus:border-blue-500" name="to_" id="toInput" autocomplete="off">
                        <ul id="toSuggestions" class="absolute bg-white text-gray-800 w-60 mt-1 rounded-md shadow-lg hidden"></ul>
                    </div>
                </div>

                <!-- Mode of Transport Section -->
                <h2 class="text-xl font-semibold mt-6 mb-4 text-gray-700">Mode of Transport</h2>
<div class="grid grid-cols-2 gap-6 md:grid-cols-4">
    <!-- Car -->
    <label class="flex flex-col items-center justify-center p-4 bg-gray-50 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-blue-500 hover:shadow-md transition peer-checked:border-blue-500 peer-checked:bg-blue-50">
        <input type="radio" name="mode_" value="Car" class="hidden peer">
        <i class="ri-car-line text-3xl text-gray-500 peer-checked:text-blue-500 mb-2"></i>
        <span class="text-sm font-medium text-gray-700 peer-checked:text-blue-500">Car</span>
    </label>

    <!-- Bus -->
    <label class="flex flex-col items-center justify-center p-4 bg-gray-50 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-blue-500 hover:shadow-md transition peer-checked:border-blue-500 peer-checked:bg-blue-50">
        <input type="radio" name="mode_" value="Bus" class="hidden peer">
        <i class="ri-bus-2-line text-3xl text-gray-500 peer-checked:text-blue-500 mb-2"></i>
        <span class="text-sm font-medium text-gray-700 peer-checked:text-blue-500">Bus</span>
    </label>

    <!-- Train -->
    <label class="flex flex-col items-center justify-center p-4 bg-gray-50 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-blue-500 hover:shadow-md transition peer-checked:border-blue-500 peer-checked:bg-blue-50">
        <input type="radio" name="mode_" value="Train" class="hidden peer">
        <i class="ri-train-line text-3xl text-gray-500 peer-checked:text-blue-500 mb-2"></i>
        <span class="text-sm font-medium text-gray-700 peer-checked:text-blue-500">Train</span>
    </label>

    <!-- Flight -->
    <label class="flex flex-col items-center justify-center p-4 bg-gray-50 border-2 border-gray-300 rounded-lg cursor-pointer hover:border-blue-500 hover:shadow-md transition peer-checked:border-blue-500 peer-checked:bg-blue-50">
        <input type="radio" name="mode_" value="Flight" class="hidden peer">
        <i class="ri-flight-takeoff-line text-3xl text-gray-500 peer-checked:text-blue-500 mb-2"></i>
        <span class="text-sm font-medium text-gray-700 peer-checked:text-blue-500">Flight</span>
    </label>
</div>
                <!-- Submit Button -->
                <input class="px-4 py-2 bg-blue-500 hover:bg-blue-600 transition text-white font-semibold rounded-md w-40 mt-6" type="submit" value="Book">
            </form>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white bg-opacity-50 py-4 shadow-md">
        <div class="container mx-auto text-center text-gray-600">
            <p>&copy; 2025 JourneySphere. All rights reserved.</p>
        </div>
    </footer>

    <script>
        async function fetchSuggestions(inputId, suggestionsId) {
            const input = document.getElementById(inputId);
            const suggestions = document.getElementById(suggestionsId);

            input.addEventListener('input', async () => {
                const query = input.value.trim();
                if (query.length < 2) {
                    suggestions.innerHTML = '';
                    suggestions.classList.add('hidden');
                    return;
                }

                try {
                    const response = await fetch(`/api/city-suggestions?name=${query}`);
                    const data = await response.json();

                    if (data.success) {
                        suggestions.innerHTML = data.cities
                            .map(city => `<li class="px-2 py-1 cursor-pointer hover:bg-gray-200">${city.name}</li>`)
                            .join('');
                        suggestions.classList.remove('hidden');

                        // Add click event to suggestions
                        Array.from(suggestions.children).forEach(item => {
                            item.addEventListener('mousedown', (e) => {
                                e.preventDefault(); // Prevent blur event from clearing the suggestions
                                input.value = item.textContent;
                                suggestions.innerHTML = '';
                                suggestions.classList.add('hidden');
                            });
                        });
                    }
                } catch (err) {
                    console.error('Error fetching suggestions:', err);
                }
            });

            // Hide suggestions when input loses focus
            input.addEventListener('blur', () => {
                setTimeout(() => {
                    suggestions.innerHTML = '';
                    suggestions.classList.add('hidden');
                }, 100);
            });
        }

        // Initialize autocomplete for "From" and "To" inputs
        fetchSuggestions('fromInput', 'fromSuggestions');
        fetchSuggestions('toInput', 'toSuggestions');
    </script>
</body>
</html>