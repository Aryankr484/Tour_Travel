<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white text-white p-10" >
        <h3 class="mb-2 text-3xl">Upload profile pic</h3>
        <div class="flex gap-2">
            <form autocomplete="off" action="/upload" method="post" enctype="multipart/form-data">
                <input type="file" name="image">
                <input class="bg-blue-600 px-5 py-2 rounded-md text-center" type="submit" value="Upload profile pic">
            </form>
            <form autocomplete="off" action="/delete" method="post" enctype="multipart/form-data">
                <input class="bg-zinc-600 px-5 py-2 rounded-md text-center" type="submit" value="Remove profile pic">
            </form>
        </div>
    </div>
</body>
</html>