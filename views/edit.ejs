<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white text-white p-10" >
        <div class="w-full flex justify-end">
            <a class="bg-red-500 rounded-md px-3 py-1 mb-5 inline-block" href="/logout">Logout</a>
        </div>
        
        
        <h5>edit passengers details</h5>
        <!-- <form method="post" action="/update/<%=post._id%>" >
            <textarea placeholder="what's on your mind" class="p-3 w-1/3 bg-transparent border-2 border-zinc-800 rounded-md resize-none" name="content" id=""><%=post.content%></textarea>
            <input class='px-3 w-40 text-sm py-2 bg-yellow-500 text-black block rounded-md mt-2' type="submit" value="Update Post">
        </form>  -->
        <form method="post" action="/update/<%=post.ID%>">
            <input placeholder="name" type="text" class="bg-transparent w-40 px-2 mb-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" name="name" id="name" value="<%= post.NAME %>">
            <input placeholder="age" type="number" class="bg-transparent w-40 px-2 mb-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" name="age" id="age" value="<%= post.AGE%>">
            <input placeholder="gender" type="text" class="bg-transparent w-40 px-2 mb-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" name="gender" id="gender" value="<%=post.GENDER%>">
            <input placeholder="phone" type="number" class="bg-transparent w-40 px-2 mb-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" name="phone" id="phone" value="<%=post.PHONE%>">
            <input class='px-3 w-40 text-sm py-2 bg-yellow-500 text-black block rounded-md mt-2' type="submit" value="Update Post">

        </form>

       
    </div>
</body>
</html> 