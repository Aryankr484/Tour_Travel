<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Previous Tickets</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen font-sans">
    <div class="container mx-auto p-6">
        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-blue-600">Your Previous Tickets</h1>
            <a href="/profile" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-md">Back to Profile</a>
        </div>

        <!-- Tickets Table -->
        <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <table class="min-w-full table-auto">
                <thead class="bg-blue-500 text-white">
                    <tr>
                        <th class="px-4 py-2 text-left">From</th>
                        <th class="px-4 py-2 text-left">To</th>
                        <th class="px-4 py-2 text-left">Mode</th>
                        <th class="px-4 py-2 text-left">Duration</th>
                        <th class="px-4 py-2 text-left">Price</th>
                        <th class="px-4 py-2 text-left">Date</th>
                        <th class="px-4 py-2 text-left">Status</th>
                        <th class="px-4 py-2 text-left">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (tickets.length > 0) { %>
                        <% tickets.forEach(ticket => { %>
                            <tr class="border-b">
                                <td class="px-4 py-2"><%= ticket.FR_ %></td>
                                <td class="px-4 py-2"><%= ticket.TO_ %></td>
                                <td class="px-4 py-2"><%= ticket.MODE_ %></td>
                                <td class="px-4 py-2"><%= ticket.DURATION %> hrs</td>
                                <td class="px-4 py-2">₹<%= ticket.PRICE %></td>
                                <td class="px-4 py-2"><%= new Date(ticket.TICKET_DATE).toLocaleDateString() %></td>
                                <td class="px-4 py-2">
                                    <% if (ticket.STATUS === 'Cancelled') { %>
                                        <span class="text-red-500 font-semibold">Cancelled</span>
                                    <% } else { %>
                                        <span class="text-green-500 font-semibold">Active</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-2">
                                    <% if (ticket.STATUS === 'Cancelled') { %>
                                        <button class="bg-gray-400 text-white px-4 py-2 rounded cursor-not-allowed" disabled>Cancelled</button>
                                    <% } else { %>
                                        <form action="/cancel-ticket/<%= ticket.ID %>" method="POST">
                                            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded">Cancel</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="px-4 py-6 text-center text-gray-500">No tickets found</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>