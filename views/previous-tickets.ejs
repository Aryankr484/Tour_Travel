<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Previous Tickets</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white p-10">
    <div class="w-full min-h-screen">
        <h3 class="text-3xl mb-5">Previous Tickets</h3>

        <table class="table-auto border-collapse w-full border border-gray-300 mt-5">
            <thead>
                <tr class="bg-gray-400 text-black">
                    <th class="border border-gray-300 px-4 py-2">From</th>
                    <th class="border border-gray-300 px-4 py-2">To</th>
                    <th class="border border-gray-300 px-4 py-2">Mode</th>
                    <th class="border border-gray-300 px-4 py-2">Duration</th>
                    <th class="border border-gray-300 px-4 py-2">Price</th>
                    <th class="border border-gray-300 px-4 py-2">Date</th>
                    <th class="border border-gray-300 px-4 py-2">Rating</th>
                    <th class="border border-gray-300 px-4 py-2">Review</th>
                    <th class="border border-gray-300 px-4 py-2">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (tickets.length > 0) { %>
                    <% tickets.forEach(function(ticket) { %>
                        <tr class="hover:bg-gray-600">
                            <td class="border border-gray-300 px-4 py-2"><%= ticket.FR_ %></td>
                            <td class="border border-gray-300 px-4 py-2"><%= ticket.TO_ %></td>
                            <td class="border border-gray-300 px-4 py-2"><%= ticket.MODE_ %></td>
                            <td class="border border-gray-300 px-4 py-2"><%= ticket.DURATION %></td>
                            <td class="border border-gray-300 px-4 py-2"><%= ticket.PRICE %></td>
                            <td class="border border-gray-300 px-4 py-2"><%= ticket.TICKET_DATE %></td>
                            <td class="border border-gray-300 px-4 py-2"><%= ticket.RATING ? ticket.RATING + '/5' : 'N/A' %></td>
                            <td class="border border-gray-300 px-4 py-2"><%= ticket.REVIEW || 'No review' %></td>
                            <td class="border border-gray-300 px-4 py-2">
                                <% if (ticket.IS_CANCELLED) { %>
                                    <button class="bg-gray-700 px-3 py-1 rounded-md text-white cursor-not-allowed" disabled>Cancelled</button>
                                <% } else { %>
                                    
                                    <form method="post" action="/delete-previous-ticket">
                                        <input type="hidden" name="ticket_id" value="<%= ticket.ID %>">
                                        <button class="bg-red-500 px-3 py-1 rounded-md text-white" data-ticket-id="<%= ticket.ID %>">Cancel</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="9" class="text-center border border-gray-300 px-4 py-2">No previous tickets found</td>
                    </tr>
                <% } %>
            </tbody>
        </table>

        <a href="/profile" class="bg-blue-500 px-4 py-2 rounded-md text-white mt-5 inline-block">Back to Profile</a>
    </div>
    <script>
 document.querySelectorAll('button[data-ticket-id]').forEach(button => {
    button.addEventListener('click', function (event) {
        event.preventDefault(); // Prevent default behavior

        const ticketId = this.getAttribute('data-ticket-id'); // Get the ticket ID from the button
        const form = this.closest('form'); // Find the closest form element

        // Send an AJAX request to cancel the ticket
        fetch(form.action, {
            method: form.method,
            body: new FormData(form)
        })
            .then(response => {
                if (response.ok) {
                    // Update the button to show "Cancelled"
                    this.textContent = "Cancelled";
                    this.classList.remove('bg-red-500');
                    this.classList.add('bg-gray-700', 'cursor-not-allowed');
                    this.disabled = true;
                } else {
                    alert('Failed to cancel the ticket. Please try again.');
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert('An error occurred while cancelling the ticket.');
            });
    });
});
    </script>
</body>

</html>