<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - JourneySphere</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css"
    rel="stylesheet"/>
</head>
<body style="background-image: url('https://images.unsplash.com/photo-1705839297791-8045185fe30a?q=80&w=1932&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');" class="bg-cover bg-center flex items-center text-gray-800 min-h-screen">
    <div class="container mx-auto p-6 md:p-10">
        <!-- Logout Button -->
        <div class="flex justify-end mb-6">
            <a class="bg-red-500 hover:bg-red-600 transition px-4 py-2 rounded-md text-white font-semibold shadow-md" href="/logout">Logout</a>
        </div>

        <!-- User Greeting -->
        <div class="flex items-center gap-6 mb-8 bg-white bg-opacity-70 p-6 rounded-lg shadow-md">
            <div class="h-20 w-20 rounded-full overflow-hidden border-4 border-blue-500">
                <a href="profile/upload">
                    <img class="w-full h-full object-cover" src="/images/uploads/<%= user.PROFILEPIC %>" alt="Profile Picture">
                </a>
            </div>
            <div>
                <h3 class="text-3xl font-bold">Hello, <span class="text-blue-500"><%= user.NAME %></span></h3>
                <p class="text-gray-600">Welcome back to your profile!</p>
            </div>
        </div>

        <!-- Journey Details -->
        <div class="bg-white bg-opacity-70 p-6 rounded-lg shadow-md mb-8">
            <h4 class="text-2xl font-semibold mb-4 text-gray-700">Your Journey</h4>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <p class="text-gray-600">From: <span class="text-blue-500 font-medium"><%= fr_ %></span></p>
                <p class="text-gray-600">To: <span class="text-blue-500 font-medium"><%= to_ %></span></p>
                <p class="text-gray-600">Mode: <span class="text-blue-500 font-medium"><%= mode_ %></span></p>
                <p class="text-gray-600">Country: <span class="text-blue-500 font-medium"><%= country %></span></p>
            </div>
            <div class="mt-6">
                <form method="post" action="/confirm" class="space-y-6">
                    <input type="hidden" name="fr_" value="<%= fr_ %>">
                    <input type="hidden" name="to_" value="<%= to_ %>">
                    <input type="hidden" name="mode_" value="<%= mode_ %>">
                    <input type="hidden" name="price" id="hidden-price"> <!-- Hidden input for price -->

                    <h5 class="text-lg font-semibold mb-4">Select the Days and Nights to Stay</h5>
<div class="grid grid-cols-2 md:grid-cols-3 gap-4">
    <!-- 1 Day 1 Night -->
    <label class="flex items-center justify-center cursor-pointer bg-gray-50 p-3 rounded-lg border border-gray-300 hover:border-blue-500 hover:shadow-md transition peer-checked:bg-blue-100 peer-checked:border-blue-500">
        <input type="radio" name="duration" value="1 Day 1 Night" class="hidden peer" data-price="5000">
        <span class="text-gray-700 peer-checked:text-blue-500">1 Day 1 Night</span>
    </label>

    <!-- 2 Days 1 Night -->
    <label class="flex items-center justify-center cursor-pointer bg-gray-50 p-3 rounded-lg border border-gray-300 hover:border-blue-500 hover:shadow-md transition peer-checked:bg-blue-100 peer-checked:border-blue-500">
        <input type="radio" name="duration" value="2 Days 1 Night" class="hidden peer" data-price="10000">
        <span class="text-gray-700 peer-checked:text-blue-500">2 Days 1 Night</span>
    </label>

    <!-- 3 Days 2 Nights -->
    <label class="flex items-center justify-center cursor-pointer bg-gray-50 p-3 rounded-lg border border-gray-300 hover:border-blue-500 hover:shadow-md transition peer-checked:bg-blue-100 peer-checked:border-blue-500">
        <input type="radio" name="duration" value="3 Days 2 Nights" class="hidden peer" data-price="15000">
        <span class="text-gray-700 peer-checked:text-blue-500">3 Days 2 Nights</span>
    </label>

    <!-- 4 Days 3 Nights -->
    <label class="flex items-center justify-center cursor-pointer bg-gray-50 p-3 rounded-lg border border-gray-300 hover:border-blue-500 hover:shadow-md transition peer-checked:bg-blue-100 peer-checked:border-blue-500">
        <input type="radio" name="duration" value="4 Days 3 Nights" class="hidden peer" data-price="20000">
        <span class="text-gray-700 peer-checked:text-blue-500">4 Days 3 Nights</span>
    </label>

    <!-- 5 Days 4 Nights -->
    <label class="flex items-center justify-center cursor-pointer bg-gray-50 p-3 rounded-lg border border-gray-300 hover:border-blue-500 hover:shadow-md transition peer-checked:bg-blue-100 peer-checked:border-blue-500">
        <input type="radio" name="duration" value="5 Days 4 Nights" class="hidden peer" data-price="25000">
        <span class="text-gray-700 peer-checked:text-blue-500">5 Days 4 Nights</span>
    </label>
</div>
+
                    <div class="mt-4">
                        <p class="text-lg font-semibold">Price: <span id="price" class="text-blue-500">0</span> INR</p>
                    </div>
                    <div class="flex gap-4 mt-6">
                        <a href="/previous-tickets" class="bg-blue-500 hover:bg-blue-600 transition px-4 py-2 rounded-md text-white font-semibold shadow-md">View Previous Tickets</a>
                        <button class="bg-green-500 hover:bg-green-600 transition px-4 py-2 rounded-md text-white font-semibold shadow-md">Confirm Booking</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Passenger Details Form -->
        <div class="bg-white  rounded-lg shadow-md mb-8 p-6">
            <h5 class="text-xl font-semibold mb-4 text-gray-700">Enter Passenger Details</h5>
            <form method="post" action="/post" class="space-y-4">
                <input placeholder="Name" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" name="name" id="name">
                <input placeholder="Age" type="number" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" name="age" id="age">
                <input placeholder="Gender" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" name="gender" id="gender">
                <input placeholder="Phone" type="number" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" name="phone" id="phone">
                <input class="px-4 py-2 bg-blue-500 hover:bg-blue-600 transition text-white rounded-md w-full shadow-md" type="submit" value="Add Passenger">
            </form>
        </div>

        <!-- Passenger Table -->
        <!-- Passenger Table -->
<div class="bg-white  p-6 rounded-lg shadow-md">
    <h5 class="text-xl font-semibold mb-4 text-gray-700">Passenger List</h5>
    <% if (user.posts.length > 0) { %>
        <table class="table-auto border-collapse w-full border border-gray-300">
            <thead>
                <tr class="bg-gray-200 text-gray-800">
                    <th class="border border-gray-300 px-4 py-2">Name</th>
                    <th class="border border-gray-300 px-4 py-2">Age</th>
                    <th class="border border-gray-300 px-4 py-2">Gender</th>
                    <th class="border border-gray-300 px-4 py-2">Phone Number</th>
                    <th class="border border-gray-300 px-4 py-2">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% user.posts.forEach(function(post) { %>
                    <tr class="hover:bg-gray-100">
                        <td class="border border-gray-300 px-4 py-2"><%= post.NAME %></td>
                        <td class="border border-gray-300 px-4 py-2"><%= post.AGE %></td>
                        <td class="border border-gray-300 px-4 py-2"><%= post.GENDER %></td>
                        <td class="border border-gray-300 px-4 py-2"><%= post.PHONE %></td>
                        <td class="border border-gray-300 px-4 py-2">
                            <a class="text-blue-500 hover:underline" href="/edit/<%= post.ID %>">Edit</a> |
                            <a class="text-red-500 hover:underline" href="/delete/<%= post.ID %>">Delete</a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <p>No passengers in the list.</p>
    <% } %>
</div>

        <!-- Clear Ticket Button -->
        <form method="post" action="/delete-ticket" class="mt-6">
            <button class="px-4 py-2 bg-red-500 hover:bg-red-600 transition text-white rounded-md w-full shadow-md" type="submit">
                Clear Ticket
            </button>
        </form>
    </div>

    <script>
        const durationInputs = document.querySelectorAll('input[name="duration"]');
        const priceElement = document.getElementById('price');
        const hiddenPriceInput = document.getElementById('hidden-price'); // Hidden input for price
        const toCountry = "<%= country %>"; // Destination country passed from the backend
    
        durationInputs.forEach(input => {
            input.addEventListener('change', () => {
                let basePrice = toCountry === 'IN' ? 1000 : 11000; // Set base price based on the country
                let durationPrice = parseInt(input.getAttribute('data-price')) || 0; // Get the price for the selected duration
                let totalPrice = basePrice + durationPrice; // Calculate the total price
                priceElement.textContent = totalPrice.toLocaleString(); // Format the price with commas
                hiddenPriceInput.value = totalPrice; // Update the hidden input value
            });
        });
    </script>
</body>
</html>