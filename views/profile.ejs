<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white text-white p-10">
        <div class="w-full flex justify-end">
            <a class="bg-red-500 rounded-md px-3 py-1 mb-5 inline-block" href="/logout">Logout</a>
        </div>
        <div class="flex gap-4 mb-3">
            <div class="h-10 w-10 rounded-md overflow-hidden">
                <a href="profile/upload"><img class="w-full h-full object-cover" src="/images/uploads/<%= user.PROFILEPIC %>" alt=""></a>
            </div>
            <h3 class="text-3xl"><span class="font-light">Hello</span>, <%= user.NAME %>👋</h3>
        </div>

        <% if (!ticketBooked) { %>
            <h5>Enter the Details of the passengers</h5>
            <form method="post" action="/post">
                <input placeholder="name" type="text" class="bg-transparent w-40 px-2 mb-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" name="name" id="name">
                <input placeholder="age" type="number" class="bg-transparent w-40 px-2 mb-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" name="age" id="age">
                <input placeholder="gender" type="text" class="bg-transparent w-40 px-2 mb-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" name="gender" id="gender">
                <input placeholder="phone" type="number" class="bg-transparent w-40 px-2 mb-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" name="phone" id="phone">
                <input class='px-3 w-40 text-sm py-2 bg-blue-500 block rounded-md mt-2' type="submit" value="Add passengers">
            </form>
        <% } else { %>
            <h5 class="text-green-500 text-xl">Ticket Booked</h5>
        <% } %>

        <table class="table-auto border-collapse w-full border border-gray-300 mt-5">
            <thead>
              <tr class="bg-gray-400 text-black">
                <th class="border border-gray-300 px-4 py-2">Name</th>
                <th class="border border-gray-300 px-4 py-2">Age</th>
                <th class="border border-gray-300 px-4 py-2">Gender</th>
                <th class="border border-gray-300 px-4 py-2">Phone Number</th>
              </tr>
            </thead>
            <tbody>
              <% user.posts.forEach(function(post) { %>
                <tr class="hover:bg-gray-600">
                  <td class="border border-gray-300 px-4 py-2"><%= post.NAME %></td>
                  <td class="border border-gray-300 px-4 py-2"><%= post.AGE %></td>
                  <td class="border border-gray-300 px-4 py-2"><%= post.GENDER %></td>
                  <td class="border border-gray-300 px-4 py-2"><%= post.PHONE %></td>
                  <%if(!ticketBooked) {%>
                    <td class="border border-gray-300 px-4 py-2"><a class="text-zinc-400" href="/edit/<%= post.ID %>">edit</a></td>
                    <td class="border border-gray-300 px-4 py-2"><a class="text-red-500" href="/delete/<%= post.ID %>">delete</a></td>
                  <% } %>
                </tr>
              <% }); %>
            </tbody>
        </table>
        <form method="post" action="/confirm">
          <%if(!ticketBooked){%>
            <input class='px-3 w-40 text-sm py-2 bg-blue-500 block rounded-md mt-2' type="submit" value="Book Ticket">
          <%} else{%>
            <input class='px-3 w-40 invisible text-sm py-2 bg-gray-300 block rounded-md mt-2' type="submit" value="Ticket Booked">
          <%}%>
        </form>
        <div class="mt-5">
          <h3 class="text-xl">Your Rating</h3>
          <% if (rating) { %>
              <p class="text-lg text-green-500"><%= rating %> ★</p>
          <% } else { %>
              <p class="text-lg text-gray-500">No rating available</p>
          <% } %>
      </div>
</body>

</html>