<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - JourneySphere Travel Co.</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  
  <body style="background-image: url('https://plus.unsplash.com/premium_photo-1670598342794-249547599860?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');" class="bg-cover bg-center flex items-center justify-center min-h-screen font-sans">
    <div class="bg-white w-[900px] h-[550px] rounded-2xl shadow-2xl flex overflow-hidden">
      
      <!-- Left Side -->
      <div class="w-1/2 bg-cover bg-center relative" style="background-image: url('https://images.unsplash.com/photo-1569949380643-6e746ecaa3bd?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');">
        <div class="absolute inset-0 bg-black bg-opacity-20 rounded-l-2xl"></div>
        <div class="absolute top-8 left-8 text-white z-10">
          <h1 class="text-3xl font-[cursive]">JourneySphere Travel Co.</h1>
          <p class="mt-2 leading-none text-sm w-64">
            Travel is the only purchase that enriches you in ways beyond material wealth
          </p>
        </div>
      </div>

      <!-- Right Side -->
      <div class="w-1/2 p-10 flex flex-col justify-center relative">
        <!-- Plane icon (optional) -->
        <div class="absolute top-5 right-5 text-blue-500 text-sm">
          ✈️
        </div>

        <!-- Popup Message -->
        <% if (typeof message !== 'undefined') { %>
          <div id="popup" class="p-4 mb-4 rounded-md text-center <% if (isSuccess) { %> bg-green-500 text-white <% } else { %> bg-red-500 text-white <% } %>">
            <%= message %>
          </div>
        <% } %>

        <h2 class="text-3xl font-bold text-blue-600 mb-6">Welcome</h2>
        <p class="text-gray-500 mb-6">Login with Email</p>

        <form action="/login" method="POST" class="space-y-4">
          <div>
            <label class="block text-sm text-gray-600 mb-1">Email id</label>
            <div class="flex items-center border border-blue-400 rounded px-3 py-2">
              <span class="material-icons text-gray-400 mr-2">mail</span>
              <input type="email" name="email" class="w-full outline-none" placeholder="thisuix@mail.com" required>
            </div>
          </div>

          <div>
            <label class="block text-sm text-gray-600 mb-1">Password</label>
            <div class="flex items-center border border-blue-400 rounded px-3 py-2">
              <span class="material-icons text-gray-400 mr-2">lock</span>
              <input type="password" name="password" class="w-full outline-none" placeholder="********" required>
            </div>
          </div>

          <div class="flex justify-between items-center text-sm">
            <div></div>
            <a href="/forgot-password" class="text-blue-400 hover:underline">Forgot your password?</a>
          </div>

          <button class="bg-blue-500 hover:bg-blue-600 text-white font-semibold w-full py-2 rounded mt-2">LOGIN</button>
        </form>

        <div class="flex items-center my-4">
          <hr class="flex-grow border-gray-300">
          <span class="mx-2 text-gray-400 text-sm">OR</span>
          <hr class="flex-grow border-gray-300">
        </div>

        <p class="text-sm text-gray-500 text-center mt-4">
          Don’t have account? <a href="/register" class="text-blue-500 hover:underline">Register Now</a>
        </p>

        <!-- Landmark icons -->
        <div class="absolute bottom-0 right-0 p-3 text-blue-500 text-xs flex space-x-2">
          <span class="text-2xl">🕌</span><span class="text-2xl">🗼</span><span class="text-2xl">🏛️</span>
        </div>
      </div>
    </div>

    <!-- Automatically hide the popup after 3 seconds -->
    <script>
      setTimeout(() => {
        const popup = document.getElementById('popup');
        if (popup) {
          popup.style.display = 'none';
        }
      }, 3000);
    </script>
  </body>
</html>