<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md bg-zinc-800 p-8 rounded-lg shadow-lg">
        <!-- Title -->
        <h1 class="text-center mb-6 text-3xl font-bold text-green-400">JourneySphere Travel Co.</h1>
        
        <!-- Display Popup Message -->
        <% if (typeof message !== 'undefined') { %>
            <div id="popup" class="p-4 mb-4 rounded-md text-center <% if (isSuccess) { %> bg-green-500 text-white <% } else { %> bg-red-500 text-white <% } %>">
                <%= message %>
            </div>
        <% } %>

        <!-- Login Section -->
        <h3 class="mb-4 text-xl font-semibold text-center">Login to Your Account</h3>
        <form action="/login" method="post" class="space-y-4">
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="email" placeholder="Email" name="email" required>
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="password" placeholder="Password" name="password" required>
            <input class="bg-blue-600 w-full px-4 py-2 rounded-md text-center text-white font-semibold hover:bg-blue-700 transition" type="submit" value="Login Account">
        </form>
    </div>

    <script>
        // Automatically hide the popup after 3 seconds
        setTimeout(() => {
            const popup = document.getElementById('popup');
            if (popup) {
                popup.style.display = 'none';
            }
        }, 3000);
    </script>
</body>
</html>