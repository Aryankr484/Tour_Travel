<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md bg-zinc-800 p-8 rounded-lg shadow-lg">
        <!-- Title -->
        <h1 class="text-center mb-6 text-3xl font-bold text-green-400">Forgot Password</h1>
        
        <!-- Forgot Password Form -->
        <form action="/forgot-password" method="post" class="space-y-4">
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="email" placeholder="Enter your email" name="email" required>
            <input class="bg-blue-600 w-full px-4 py-2 rounded-md text-center text-white font-semibold hover:bg-blue-700 transition" type="submit" value="Send Reset Link">
        </form>

        <!-- Back to Login -->
        <div class="mt-4 text-center">
            <a href="/login" class="text-blue-400 hover:underline">Back to Login</a>
        </div>
    </div>
</body>
</html>