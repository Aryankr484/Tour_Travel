<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JourneySphere Travel Co.</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white text-white p-10" >
        <h1 class="text-center mb-5 text-3xl font-bold">JourneySphere Travel Co.</h1>
        <h3 class="mb-2 text-3xl">Create Account</h3>
        <form action="/register" method="post">
            <input class="bg-transparent px-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" type="text" placeholder="name" name="name">
            <input class="bg-transparent px-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" type="text" placeholder="username" name="username">
            <input class="bg-transparent px-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" type="email" placeholder="email" name="email">
            <input class="bg-transparent px-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" type="password" placeholder="password" name="password">
            <input class="bg-transparent px-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" type="number" placeholder="age" name="age">
            <input class="bg-transparent px-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" type="number" placeholder="phone" name="phone">
            <input class="bg-transparent px-2 py-2 border-2 rounded-lg border-zinc-700 outline-none" type="text" placeholder="gender" name="gender">
            <input class="bg-blue-600 px-2 py-2 rounded-md text-center" type="submit" value="Create Account">
        </form>
        <span><h3 class="inline-block mr-3">Alreay a user?</h3></span><a class="bg-green-500 rounded-md px-3 py-1 mb-5 inline-block" href="/login">Login</a>
    </div>
</body>
</html>