<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md bg-zinc-800 p-8 rounded-lg shadow-lg">
        <!-- Title -->
        <h1 class="text-center mb-6 text-3xl font-bold text-green-400">JourneySphere Travel Co.</h1>

        <!-- Display Alert Message -->
        <% if (typeof message !== 'undefined') { %>
            <% if (isSuccess) { %>
                <div class="bg-green-500 text-white p-3 rounded-md mb-5" id="alert-box">
                    <%= message %>
                </div>
                <h3 class="mb-4 text-xl font-semibold text-center">Login to Your Account</h3>
                <form action="/login" method="post" class="space-y-4">
                    <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="email" placeholder="Email" name="email" required>
                    <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="password" placeholder="Password" name="password" required>
                    <input class="bg-blue-600 w-full px-4 py-2 rounded-md text-center text-white font-semibold hover:bg-blue-700 transition" type="submit" value="Login Account">
                </form>
            <% } else { %>
                <div class="bg-red-500 text-white p-3 rounded-md mb-5" id="alert-box">
                    <%= message %>
                </div>
            <% } %>
        <% } %>

        <!-- Registration Form -->
        <h3 class="mb-4 text-xl font-semibold text-center">Register Your Account</h3>
        <form action="/register" method="post" class="space-y-4">
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="text" placeholder="Username" name="username" required>
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="text" placeholder="Name" name="name" required>
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="number" placeholder="Age" name="age" required>
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="email" placeholder="Email" name="email" required>
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="text" placeholder="Gender" name="gender" required>
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="number" placeholder="Phone" name="phone" required>
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="password" placeholder="Password" name="password" required>
            <input class="bg-blue-600 w-full px-4 py-2 rounded-md text-center text-white font-semibold hover:bg-blue-700 transition" type="submit" value="Register Account">
        </form>

        <!-- Login Section -->
        <div class="mt-6 text-center">
            <h3 class="inline-block mr-2 text-gray-300">Already a user?</h3>
            <a class="bg-green-500 hover:bg-green-600 transition px-4 py-2 rounded-md text-white font-semibold" href="/login">Login</a>
        </div>
    </div>

    <script>
        // Automatically hide the alert after 3 seconds
        setTimeout(() => {
            const alertBox = document.getElementById('alert-box');
            if (alertBox) {
                alertBox.style.display = 'none';
            }
        }, 3000);
    </script>
</body>
</html>