<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md bg-zinc-800 p-8 rounded-lg shadow-lg">
        <!-- Title -->
        <h1 class="text-center mb-6 text-3xl font-bold text-green-400">Reset Password</h1>
        
        <!-- Reset Password Form -->
        <form action="/reset-password" method="post" class="space-y-4">
            <input type="hidden" name="token" value="<%= token %>">
            <input class="bg-transparent w-full px-4 py-2 border-2 rounded-lg border-zinc-700 outline-none focus:border-green-500" type="password" placeholder="Enter new password" name="password" required>
            <input class="bg-blue-600 w-full px-4 py-2 rounded-md text-center text-white font-semibold hover:bg-blue-700 transition" type="submit" value="Reset Password">
        </form>
    </div>
</body>
</html>